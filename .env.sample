# 活跃 AI 服务商：mock（本地离线）、deepseek、claude、openai、qwen、glm、volcengine。
# 设置页可以切换此值，也可以填写/清除密钥；写入只发生在本地 .env.local。
AI_ACTIVE_PROVIDER=mock

# 每个服务商的密钥都可由设置页或手工写入本文件；只会写回本地，
# 不会写入数据库、返回给前端或写入日志。
# BASE_URL / MODEL / REASONING_MODEL 留空即使用下面注释里的默认值。

# DeepSeek（OpenAI ChatCompletions 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

# Claude（Anthropic Messages 协议）。密钥名沿用官方惯例 ANTHROPIC_API_KEY，
# 与设置页里显示的 claude 不同名。
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_REASONING_MODEL=claude-opus-4-6

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_REASONING_MODEL=gpt-4.1

# 通义千问（百炼，OpenAI 兼容模式）
QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
# QWEN_REASONING_MODEL=qwen-max

# 智谱 GLM
GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4-flash
# GLM_REASONING_MODEL=glm-4-plus

# 火山豆包（方舟）
VOLCENGINE_API_KEY=
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VOLCENGINE_MODEL=doubao-pro-32k
# VOLCENGINE_REASONING_MODEL=doubao-pro-256k

# 云端 TTS（可选，与上面的对话服务商相互独立）：配置后单词/句子发音优先使用
# DashScope CosyVoice，未配置时回退到本机 Windows SAPI。
DASHSCOPE_API_KEY=
DASHSCOPE_TTS_VOICE=longxiaochun
