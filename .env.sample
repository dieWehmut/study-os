# 活跃 AI 服务商：mock（本地离线）、deepseek、claude、openai、qwen、glm、volcengine。
# 设置页可以切换此值，也可以填写/清除密钥；写入只发生在本地 .env.local。
AI_ACTIVE_PROVIDER=mock

# 每个服务商的密钥都可由设置页或手工写入本文件；只会写回本地，
# 不会写入数据库、返回给前端或写入日志。
# BASE_URL / MODEL / REASONING_MODEL 留空即使用下面注释里的默认值。

# DeepSeek（OpenAI ChatCompletions 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

# Claude（Anthropic Messages 协议）。密钥名沿用官方惯例 ANTHROPIC_API_KEY，
# 与设置页里显示的 claude 不同名。
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_REASONING_MODEL=claude-opus-4-6

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_REASONING_MODEL=gpt-4.1

# 通义千问（百炼，OpenAI 兼容模式）
QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
# QWEN_REASONING_MODEL=qwen-max

# 智谱 GLM
GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4-flash
# GLM_REASONING_MODEL=glm-4-plus

# 火山豆包（方舟）
VOLCENGINE_API_KEY=
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VOLCENGINE_MODEL=doubao-pro-32k
# VOLCENGINE_REASONING_MODEL=doubao-pro-256k

# 语音合成（可选，与上面的对话服务商相互独立）：兼容任意 OpenAI 风格的音频接口
# ——OpenAI、OpenRouter、Groq、SiliconFlow、Azure 或本地服务。设置页可以填写这些值。
# 合成走 POST {SPEECH_BASE_URL}/audio/speech，未配置时回退到本机 Windows SAPI。
#
# SPEECH_PROVIDER 只是设置页里的预设名，用来带出默认地址/模型/发音人：
#   openai | openrouter | groq | siliconflow | azure_openai | local | custom
SPEECH_PROVIDER=custom
SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_MODEL=
SPEECH_VOICE=
# 输出容器：wav（默认）、mp3、ogg、m4a、aac、flac
SPEECH_FORMAT=

# 各家的常用取值：
#   OpenAI       BASE_URL=https://api.openai.com/v1      MODEL=gpt-4o-mini-tts  VOICE=alloy
#   OpenRouter   BASE_URL=https://openrouter.ai/api/v1   MODEL=openai/gpt-4o-mini-tts
#   Groq         BASE_URL=https://api.groq.com/openai/v1 MODEL=playai-tts       VOICE=Arista-PlayAI
#   SiliconFlow  BASE_URL=https://api.siliconflow.cn/v1  MODEL=FunAudioLLM/CosyVoice2-0.5B
#   Azure        BASE_URL 填部署完整地址（可带 ?api-version=），认证走 api-key 头
#   本地服务     BASE_URL=http://127.0.0.1:8100/v1       通常不需要 API Key
#
# 发音人名称在多数厂商是区分大小写的，请照厂商文档原样填写。
# 「语音合成」设置页还能保存多个语音角色（名字/头像/简介），角色可以指向自己的
# 接口地址与发音人，切换角色即可换一把嗓子。

# 旧版云端发音（DashScope CosyVoice 原生协议）。仍然可用，排在上面的语音合成之后，
# 新配置建议直接用 SPEECH_* 。
DASHSCOPE_API_KEY=
DASHSCOPE_TTS_VOICE=longxiaochun
