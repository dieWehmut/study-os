# 活跃 AI 服务商：mock（本地离线）或 deepseek（已接入）。
# 设置页可以切换此值，只会改写下面这一行；密钥类变量只能手工编辑。
AI_ACTIVE_PROVIDER=mock

# DeepSeek（已接入，OpenAI ChatCompletions 兼容）
# 密钥只从进程环境读取，不会写入数据库、返回给前端或写入日志。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

# 云端 TTS（可选）：配置后单词/句子发音优先使用 DashScope CosyVoice，
# 未配置时回退到本机 Windows SAPI。
DASHSCOPE_API_KEY=
DASHSCOPE_TTS_VOICE=longxiaochun

# 其他厂商预留（暂未接入，设置页会显示为“待接入”）
# QWEN_API_KEY=
# GLM_API_KEY=
# OPENAI_API_KEY=
